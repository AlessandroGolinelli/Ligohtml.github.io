---
// Tutto ciò che è tra i trattini viene eseguito dal server al momento della build.
const username = "Ligohtml";

// Chiamiamo le API pubbliche di GitHub
const response = await fetch(`https://api.github.com/users/${username}/repos?sort=updated`);
let repos = await response.json();

// Filtriamo per non mostrare i fork o i progetti vuoti
repos = repos.filter(repo => !repo.fork && repo.description);
---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <title>Il mio Portfolio</title>
    <!-- Uno stile minimalista in perfetto stile Flavio Copes -->
    <style>
      body { font-family: system-ui, sans-serif; max-width: 800px; margin: 0 auto; padding: 2rem; line-height: 1.6; }
      .progetto { margin-bottom: 2rem; border-bottom: 1px solid #eee; padding-bottom: 1rem; }
      a { color: #0056b3; text-decoration: none; font-weight: bold; font-size: 1.2rem; }
      a:hover { text-decoration: underline; }
    </style>
  </head>
  <body>
    <h1>I miei Progetti GitHub</h1>
    <p>Questo sito si aggiorna automaticamente con le mie ultime repository.</p>

    <div>
      {repos.map((repo) => (
        <div class="progetto">
          <a href={repo.html_url} target="_blank">{repo.name}</a>
          <p>{repo.description}</p>
          <small>⭐ {repo.stargazers_count} Stelle | Linguaggio: {repo.language}</small>
        </div>
      ))}
    </div>
  </body>
</html>
